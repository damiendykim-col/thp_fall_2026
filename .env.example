NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Temporarily enable server operation timings in Vercel runtime logs.
PERF_LOGGING=false

# Local development only; requires a loopback Supabase URL and NODE_ENV=development.
# Ignored on Vercel and in production builds. Never replaces real session/RLS checks.
E2E_AUTH_ENABLED=false

# Server-only challenge generation. Keep real secrets in Vercel.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=configure-in-vercel
# Uses the existing Vercel Supabase integration secret or service-role key.
# SUPABASE_SECRET_KEY=configure-in-vercel
